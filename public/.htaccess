# Nexus (React SPA) — Apache/LiteSpeed rewrite rules for Hostinger
# Client-side routing (react-router-dom) needs every unknown path to fall
# through to index.html, otherwise direct links / refreshes 404.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files/directories as-is (js, css, images, favicon, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else goes to index.html so React Router can take over
  RewriteRule ^ index.html [L]
</IfModule>

# Cache hashed static assets aggressively; never cache index.html
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
